# Variables de entorno de src/frontend.
# Copiar este archivo como ".env.local" y completar los valores reales.
# La aplicación de esta fase funciona sin estas variables configuradas.

# URL del proyecto Supabase (Project URL en la sección API/Settings).
VITE_SUPABASE_URL=

# Clave pública (publishable/anon) del proyecto Supabase. No usar la clave de servicio.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Módulo lógico de ambiente cuya última lectura muestra la pantalla Cuna.
# Opcional: si se omite se usa "cuna-ambiente-01".
VITE_AMBIENTE_DEVICE_ID=cuna-ambiente-01
