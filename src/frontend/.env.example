# Variables de entorno de src/frontend.
# Copiar este archivo como ".env.local" y completar los valores reales.
# La aplicación de esta fase funciona sin estas variables configuradas.

# URL del proyecto Supabase (Project URL en la sección API/Settings).
VITE_SUPABASE_URL=

# Clave pública (publishable/anon) del proyecto Supabase. No usar la clave de servicio.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Módulo lógico de ambiente cuya última lectura muestra la pantalla Cuna.
# Opcional: si se omite se usa "cuna-ambiente-01".
VITE_AMBIENTE_DEVICE_ID=cuna-ambiente-01

# Controles de la lámpara en la pantalla Cuna. Opt-in: solo el valor exacto
# "true" los activa; vacío o ausente los deja totalmente inactivos. Activar solo
# cuando exista el backend de la lámpara y la prueba con la Pico.
VITE_LAMPARA_HABILITADA=

# Módulo lógico de la lámpara (distinto del de ambiente).
# Opcional: si se omite se usa "cuna-lampara-01".
VITE_LAMPARA_DEVICE_ID=cuna-lampara-01

# Panel "Último movimiento" (sensor PIR) en Cuna. Opt-in: solo "true" lo activa;
# si se omite o tiene otro valor queda apagado.
VITE_MOVIMIENTO_HABILITADO=false

# Módulo lógico de movimiento. Opcional: si se omite se usa "cuna-movimiento-01".
VITE_MOVIMIENTO_DEVICE_ID=cuna-movimiento-01

# Nombre de usuario del bot de Telegram (sin @). Opcional: con él la pantalla
# Bebés y dispositivos ofrece un enlace directo para vincular un destinatario.
VITE_TELEGRAM_BOT=

# Controles que operan hardware (figuras LED, audio y monitoreo de movimiento).
# Opt-in: solo el valor exacto "true" los activa. Activar solo cuando exista el
# backend de órdenes y la Pico configurada con ORDENES_* en secrets.py.
VITE_ORDENES_HABILITADAS=

# Voz del cuidador en vivo (usa el micrófono del navegador). Opt-in aparte.
VITE_VOZ_HABILITADA=

# Módulos y producto de la cuna. Opcionales: por defecto cuna-figuras-01,
# cuna-audio-01 y cuna-01.
VITE_FIGURAS_DEVICE_ID=cuna-figuras-01
VITE_AUDIO_DEVICE_ID=cuna-audio-01
VITE_CUNA_PRODUCTO_ID=cuna-01

# Módulo del colchón (módulo separado de la cuna). Opcional: por defecto cuna-colchon-01.
# Los controles del colchón (activar, detener, rearmar) usan VITE_ORDENES_HABILITADAS.
VITE_COLCHON_DEVICE_ID=cuna-colchon-01
